#!/bin/sh
# Port format 1 check (docs/FORMAT.md). Identical in every port; generated by `decomp port new`.
# Usage: ci/format-check [--strict]   (--strict: rows listed in ci/format-pending also fail; release builds use it)
set -eu
cd "$(dirname "$0")/.."
strict=0
[ "${1:-}" = "--strict" ] && strict=1
fail=0
bad() { echo "format: $*" >&2; fail=1; }
pending() { [ -f ci/format-pending ] && grep -q "^$1 " ci/format-pending; }

for path in port.json platform/port src/common src/platform src/renderer src/sound src/input src/install \
    src/game/g_public.h packaging tests/iface tests/install cmake/shim.cmake ci/check docs/FORMAT.md \
    .github/workflows/ci.yml; do
    [ -e "$path" ] || pending "$path" || bad "missing $path"
done
grep -q '"format": *1' port.json 2>/dev/null || bad "port.json: no \"format\": 1"

# Top level: only the format's entries (plus dotfiles and the usual root files).
for entry in $(git ls-tree --name-only HEAD); do
    case "$entry" in
        .*|port.json|platform|src|packaging|tests|tools|cmake|ci|docs|CMakeLists.txt|CMakePresets.json|LICENSE|README.md|SOURCES.md|PROVENANCE.md) ;;
        *) if pending "$entry"; then
               [ "$strict" = 1 ] && bad "pending move not done: $entry ($(grep "^$entry " ci/format-pending | cut -d' ' -f2-))"
               echo "format: pending $entry ($(grep "^$entry " ci/format-pending | cut -d' ' -f2-))" >&2
           else bad "unexpected top-level entry $entry"; fi ;;
    esac
done

# One workflow; schedule + workflow_dispatch only (billed private repos, at most twice a day).
for wf in .github/workflows/*.yml; do
    [ -e "$wf" ] || continue
    [ "$wf" = .github/workflows/ci.yml ] || pending "$wf" || bad "extra workflow $wf"
    if grep -Eq '^[[:space:]]*(push|pull_request|pull_request_target):' "$wf"; then bad "$wf: push/pull_request trigger"; fi
done
if [ -f .github/workflows/ci.yml ]; then
    crons=$(grep -cE "^[[:space:]]*- cron:" .github/workflows/ci.yml || true)
    [ "$crons" -le 1 ] || bad "ci.yml: more than one cron line"
    if grep -E "^[[:space:]]*- cron:" .github/workflows/ci.yml | grep -Eq "'[^ ]+ [^ ]*,[^ ]*,[^ ]* "; then
        bad "ci.yml: cron runs more than twice a day"
    fi
fi

# No cartridge bytes in the repository.
if git ls-files | grep -Eiq '\.(z64|n64|v64)$'; then bad "ROM image tracked"; fi

[ "$strict" = 0 ] || [ ! -s ci/format-pending ] || bad "ci/format-pending is not empty"
[ "$fail" = 0 ] && echo "format: ok (format 1)"
exit "$fail"
