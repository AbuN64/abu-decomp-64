# Run the executable headless; require exit code 1 and every gate line, in order, in its output.
execute_process(COMMAND ${EXECUTABLE} --headless OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE code)
set(log "${out}${err}")
if(NOT code EQUAL 1)
    message(FATAL_ERROR "boot gate: expected exit 1 at the explicit stop, got ${code}\n${log}")
endif()
file(STRINGS ${GATE} lines)
set(rest "${log}")
set(count 0)
foreach(line IN LISTS lines)
    string(FIND "${rest}" "${line}" at)
    if(at EQUAL -1)
        message(FATAL_ERROR "boot gate: missing or out of order after ${count} lines: ${line}\n${log}")
    endif()
    string(LENGTH "${line}" length)
    math(EXPR next "${at} + ${length}")
    string(SUBSTRING "${rest}" ${next} -1 rest)
    math(EXPR count "${count} + 1")
endforeach()
message(STATUS "boot gate: ${count}/${count} lines in order")
