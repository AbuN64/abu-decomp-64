# Drives the three charge_port variants (charge_port/CMakeLists.txt) with nested configure and build steps.
foreach(var N64C_SHIM_DIR SOURCE WORK)
    if(NOT DEFINED ${var})
        message(FATAL_ERROR "charge_port_run: ${var} is required")
    endif()
endforeach()
function(run variant step expect_ok pattern)
    set(dir "${WORK}/${variant}")
    if(step STREQUAL "configure")
        set(argv "${CMAKE_COMMAND}" -S "${SOURCE}" -B "${dir}" -DN64C_SHIM_DIR=${N64C_SHIM_DIR}
            -DCHARGE_PORT_VARIANT=${variant})
    else()
        set(argv "${CMAKE_COMMAND}" --build "${dir}")
    endif()
    execute_process(COMMAND ${argv} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE out)
    if(expect_ok AND NOT rc EQUAL 0)
        message(FATAL_ERROR "${variant} ${step} failed (${rc}):\n${out}")
    endif()
    if(NOT expect_ok AND rc EQUAL 0)
        message(FATAL_ERROR "${variant} ${step} succeeded, it must stop:\n${out}")
    endif()
    if(pattern AND NOT out MATCHES "${pattern}")
        message(FATAL_ERROR "${variant} ${step}: output lacks '${pattern}':\n${out}")
    endif()
endfunction()
file(REMOVE_RECURSE "${WORK}")
run(default configure TRUE "")
run(default build TRUE "")
file(READ "${WORK}/default/n64c-charge/charged_table.c" table)
if(NOT table MATCHES "\"original_fn\"" OR table MATCHES "\"shim_glue\"")
    message(FATAL_ERROR "charged table must name original_fn and not the port's native shim_glue:\n${table}")
endif()
run(no_port_dir configure FALSE "PORT_DIR is required")
run(no_glue configure TRUE "")
run(no_glue build FALSE "nowhere/sched_glue.c")
